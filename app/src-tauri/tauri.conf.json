{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gigamap",
  "version": "0.1.3",
  "identifier": "dev.rengi.gigamap",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Gigamap",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] },
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Ultra-fast disk usage analyzer",
    "longDescription": "See what fills your drives in seconds. Reads the NTFS master file table directly.",
    "externalBin": ["binaries/gigamap"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
